# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# Get the bot token from @BotFather. If it is ever pasted into a chat, an
# email, or a screenshot, revoke it with /revoke and generate a new one --
# anyone holding it can act as the bot.
TELEGRAM_BOT_TOKEN=

DATABASE_URL=postgresql://lookzi:lookzi@localhost:5433/lookzi
S3_ENDPOINT=http://localhost:9000
S3_KEY=lookzi
S3_SECRET=lookzi-dev-secret
S3_BUCKET=lookzi

TRIAL_CREDITS=20

# The public link to the studio. Never the real value in this file.
NGROK_AUTHTOKEN=
